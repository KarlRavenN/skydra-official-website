# ==========================================
# SKYDRA RAP BATTLE LEAGUE - ENVIRONMENT CONFIGURATION
# ==========================================

# Supabase Public API (Accessible in browser and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (NEVER expose to the client. Used only in secure server actions/routes)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Base site URL for ticket links, QR codes, and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
